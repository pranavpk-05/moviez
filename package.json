{
  "name": "behind-the-frame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "ingest:wikidata": "node --env-file=.env.local scripts/ingest-wikidata.mjs",
    "ingest:upload": "node --env-file=.env.local scripts/upload-catalogue.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run evaluate && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
