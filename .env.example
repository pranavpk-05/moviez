# Browser-safe project URL and publishable/anon key only. Set locally; never commit real keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_AUTH_ENABLED=false
# Server-side CLI ingestion only. NEVER prefix a privileged key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WIKIDATA_USER_AGENT=BehindTheFrame/1.0 (set a contact email)
# TMDB API Read Access Token: SERVER ONLY. Never use a VITE_ prefix for this value.
TMDB_READ_ACCESS_TOKEN=
